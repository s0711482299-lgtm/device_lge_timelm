java_library {
    name: "lge-camera-compat",
    srcs: ["compat/src/**/*.java"],
    installable: true,
    platform_apis: true,
    system_ext_specific: true,
}

// LG framework resource package required by the stock camera. It must be
// re-signed with the Lineage platform certificate because its manifest uses
// android.uid.system and publishes the com.lge.resources shared library.
android_app_import {
    name: "LgeResourcesPort",
    apk: "prebuilt/lge-res.apk",
    privileged: true,
    certificate: "platform",
    dex_preopt: {
        enabled: false,
    },
}

android_app_import {
    name: "LGCameraAppPort",
    apk: "prebuilt/LGCameraApp.apk",
    privileged: true,
    certificate: "platform",
    system_ext_specific: true,
    dex_preopt: {
        enabled: false,
    },
    enforce_uses_libs: false,
    required: [
        "lge-camera-compat",
        "com.lge.camera.compat.lgdynamicactionbar.xml",
        "lge_camera_hiddenapi_whitelist.xml",
        "privapp-permissions-lge-camera.xml",
    ],
}

android_app_import {
    name: "LGCameraSolutionPort",
    apk: "prebuilt/LGCameraSolution.apk",
    privileged: true,
    certificate: "platform",
    system_ext_specific: true,
    dex_preopt: {
        enabled: false,
    },
    enforce_uses_libs: false,
}

dex_import {
    name: "com.lge.camerasolution",
    jars: ["prebuilt/com.lge.camerasolution.jar"],
    system_ext_specific: true,
}

prebuilt_etc {
    name: "com.lge.camerasolution.xml",
    src: "permissions/com.lge.camerasolution.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}

prebuilt_etc {
    name: "com.lge.camera.compat.lgdynamicactionbar.xml",
    src: "permissions/com.lge.camera.compat.lgdynamicactionbar.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}

prebuilt_etc {
    name: "lge_camera_config.xml",
    src: "prebuilt/camera_config.xml",
    filename: "camera_config.xml",
    system_ext_specific: true,
}

prebuilt_etc {
    name: "privapp-permissions-lge-camera.xml",
    src: "permissions/privapp-permissions-lge-camera.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}

prebuilt_etc {
    name: "lge_camera_hiddenapi_whitelist.xml",
    src: "permissions/lge_camera_hiddenapi_whitelist.xml",
    sub_dir: "sysconfig",
    system_ext_specific: true,
}

// LG V40G Feature2 graph implementations. The stock camera HAL dlopens these
// names directly from /vendor/lib64. Without them the first capture request is
// rejected with ENOSYS (-38), leaving a black preview and inert controls.
cc_prebuilt_library_shared {
    name: "com.lge.feature2.swmf",
    srcs: ["prebuilt/vendor/lib64/com.lge.feature2.swmf.so"],
    compile_multilib: "64",
    vendor: true,
    strip: { none: true },
    check_elf_files: false,
}

cc_prebuilt_library_shared {
    name: "com.qti.feature2.anchorsync",
    srcs: ["prebuilt/vendor/lib64/com.qti.feature2.anchorsync.so"],
    compile_multilib: "64",
    vendor: true,
    strip: { none: true },
    check_elf_files: false,
}

